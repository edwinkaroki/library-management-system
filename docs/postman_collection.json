{
  "info": {
    "_postman_id": "a9e62310-7521-4f9e-a89b-9c2b4cb159e1",
    "name": "Library Management System API",
    "description": "Complete collection of API endpoints for Library Management System: Auth, Users, Genres, and Books.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "genreId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Librarian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@library.org\",\n  \"password\": \"LibrarianPass123!\",\n  \"name\": \"Head Librarian\",\n  \"role\": \"LIBRARIAN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new librarian user with role LIBRARIAN."
          }
        },
        {
          "name": "Register Patron",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@example.com\",\n  \"password\": \"PatronPass123!\",\n  \"name\": \"Alice Reader\",\n  \"role\": \"PATRON\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a standard patron user."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken || res.access_token) {",
                  "    pm.collectionVariables.set('token', res.accessToken || res.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@library.org\",\n  \"password\": \"LibrarianPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in with email/password and returns a JWT access token."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            },
            "description": "Fetches authenticated user profile using @Req() from the JWT token."
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('genreId', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Historical Fiction\",\n  \"description\": \"Novels capturing historical eras with fictional narratives.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Creates a new genre."
          }
        },
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Retrieves all genres in alphabetical order."
          }
        },
        {
          "name": "Get Genre By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genreId}}"]
            },
            "description": "Retrieves a single genre by its ID along with its associated books."
          }
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Historical Fiction & Epics\",\n  \"description\": \"Updated description for historical fiction and epics.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genreId}}"]
            },
            "description": "Updates an existing genre."
          }
        },
        {
          "name": "Delete Genre",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genreId}}"]
            },
            "description": "Deletes a genre by ID."
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books (Filtered, Search & Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?genreId={{genreId}}&search=dune&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "genreId",
                  "value": "{{genreId}}",
                  "description": "Filter by genre ID"
                },
                {
                  "key": "search",
                  "value": "dune",
                  "description": "Search by title or author"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (defaults to 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (defaults to 10)"
                }
              ]
            },
            "description": "Retrieves books with optional genre filtering, title/author search, and pagination."
          }
        },
        {
          "name": "Get Book By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "description": "Retrieves a single book with its genre and reviews."
          }
        },
        {
          "name": "Create Book (Guarded - LIBRARIAN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('bookId', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune Messiah\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"9780441172696\",\n  \"totalCopies\": 5,\n  \"availableCopies\": 5,\n  \"publishedYear\": 1969,\n  \"genreId\": \"{{genreId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Creates a new book in the catalog. Requires LIBRARIAN role."
          }
        },
        {
          "name": "Update Book (Guarded - LIBRARIAN)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 8,\n  \"availableCopies\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "description": "Updates a book's details or copies. Requires LIBRARIAN role."
          }
        },
        {
          "name": "Delete Book (Guarded - LIBRARIAN)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "description": "Removes a book from the catalog. Requires LIBRARIAN role."
          }
        }
      ]
    }
  ]
}

