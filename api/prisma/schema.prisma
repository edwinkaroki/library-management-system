datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATRON
  LIBRARIAN
}

enum BorrowStatus {
  PENDING
  APPROVED
  REJECTED
  BORROWED
  RETURNED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String?
  name           String?
  role           Role            @default(PATRON)
  reviews        Review[]
  borrowRequests BorrowRequest[]
  bookings       Booking[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Book {
  id              String          @id @default(uuid())
  title           String
  author          String
  isbn            String?         @unique
  publishedYear   Int?
  availableCopies Int             @default(1)
  totalCopies     Int             @default(1)
  genreId         String
  genre           Genre           @relation(fields: [genreId], references: [id], onDelete: Restrict)
  reviews         Review[]
  borrowRequests  BorrowRequest[] @relation("BorrowRequestBooks")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BorrowRequest {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  books      Book[]       @relation("BorrowRequestBooks")
  status     BorrowStatus @default(PENDING)
  dueDate    DateTime?
  returnDate DateTime?
  fineAmount Decimal      @default(0) @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model Space {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  capacity    Int       @default(1)
  isActive    Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String
  space     Space         @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  startAt   DateTime
  endAt     DateTime
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([spaceId, startAt, endAt, status])
  @@index([userId, createdAt])
}
